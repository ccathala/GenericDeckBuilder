# Variables d'environnement pour la production frontend

# URL de l'API backend (à ajuster selon votre déploiement)
VITE_API_BASE_URL=https://your-app.railway.app/api

# Environnement
VITE_APP_ENV=production

# Configuration pour les builds
VITE_APP_VERSION=$npm_package_version

# Sécurité - Désactiver les source maps en production
GENERATE_SOURCEMAP=false
VITE_SOURCE_MAP=false

# Configuration de base pour les jeux supportés
VITE_DEFAULT_GAME_ID=mage_noir

# Debug désactivé en production
VITE_DEBUG=false
