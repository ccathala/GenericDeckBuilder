# Configuration Railway pour GenericDeckBuilder

# Variables d'environnement requises pour Railway :

# Database
DATABASE_URL = ${{Postgres.DATABASE_URL}}

# JWT Security
JWT_SECRET = super-secure-jwt-secret-key-for-production-environment-must-be-at-least-256-bits-long

# Spring Profile
SPRING_PROFILES_ACTIVE = prod

# Port (Railway le définit automatiquement)
PORT = ${{PORT}}

# CORS (ajuster selon votre domaine)
CORS_ALLOWED_ORIGINS = https://${{RAILWAY_STATIC_URL}},https://your-custom-domain.com

# Logging level
LOGGING_LEVEL_ROOT = INFO
