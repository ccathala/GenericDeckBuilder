# Variables d'environnement pour le développement

# URL de l'API backend local
VITE_API_BASE_URL=http://localhost:8080/api

# Environnement
VITE_APP_ENV=development

# Configuration pour les builds de dev - Source maps activées
GENERATE_SOURCEMAP=true
VITE_SOURCE_MAP=true

# Configuration de base pour les jeux supportés
VITE_DEFAULT_GAME_ID=mage_noir

# Debug activé en développement
VITE_DEBUG=true

# Logs de développement activés
VITE_ENABLE_DEV_LOGS=true
